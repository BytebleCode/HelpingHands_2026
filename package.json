{
  "name": "helping-hands-zos",
  "private": true,
  "version": "0.1.0",
  "description": "Helping Hands packaged for z/OS UNIX (IBM-1047 / EBCDIC). The web client is prebuilt in client/dist.",
  "scripts": {
    "postinstall": "npm --prefix server install --omit=dev",
    "start": "npm --prefix server start",
    "seed": "npm --prefix server run seed",
    "train": "npm --prefix server run train",
    "train-intent": "npm --prefix server run train-intent",
    "reset": "npm --prefix server run reset",
    "test": "npm --prefix server test"
  }
}
