# Files served or run on z/OS are stored in EBCDIC (IBM-1047), so git must never convert,
# diff or merge them as text.
* binary

# These stay readable (ASCII/UTF-8): docs, git config, and the workstation build tools.
*.md text diff eol=lf
.gitattributes text diff eol=lf
.gitignore text diff eol=lf
tools/** text diff eol=lf

# Image credits are part of the website, so they are EBCDIC like the rest of it.
images/*.md binary
