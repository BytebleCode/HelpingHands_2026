# Helping Hands for Apache on z/OS. index.html is the entrance, and the app uses #/ routes
# (index.html#/rewards), so it works from any folder without rewrite rules.
# Needs AllowOverride FileInfo Indexes, and mod_charset_lite loaded (see apache/helping-hands.conf).
DirectoryIndex index.html
Options -Indexes

AddType application/json .json
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType font/woff .woff

# Text files are stored in EBCDIC (IBM-1047); browsers need ASCII. Convert text only:
# images and fonts are binary and must go out unchanged.
<FilesMatch "\.(html|js|css|json|svg|webmanifest|md)$">
    CharsetSourceEnc IBM-1047
    CharsetDefault ISO8859-1
</FilesMatch>

# Keep the setup script, docs, Apache config, build tools and git data out of the website.
RedirectMatch 404 /(tools|apache|\.git)(/|$)
RedirectMatch 404 /(zos-setup\.sh|README[^/]*\.md|\.git[a-z]*|\.ht[a-z]*)$
